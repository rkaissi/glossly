{
  "name": "glossly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "pnpm helper:build && pnpm --filter @glossly/shell-electron dev",
    "build": "pnpm helper:build && pnpm --filter @glossly/shell-electron build",
    "dist": "pnpm helper:publish && pnpm --filter @glossly/shell-electron dist",
    "helper:build": "dotnet build helpers/windows/GlosslyHelper.csproj -c Debug -v quiet -nologo",
    "helper:publish": "dotnet publish helpers/windows/GlosslyHelper.csproj -c Release -r win-x64 --self-contained true -o helpers/windows/publish -v quiet -nologo",
    "helper:record": "node scripts/record-helper.mjs",
    "test": "vitest run",
    "eval": "vitest run --project evals && node evals/print-results.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
